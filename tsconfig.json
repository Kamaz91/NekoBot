{
  "include": [
    "./src/*.ts",
    "src/types/environment.d.ts"
  ],
  "exclude": [
    "node_modules",
    "build"
  ],
  "compilerOptions": {
    "skipLibCheck": true,
    "module": "Node16",
    "moduleResolution": "node16",
    "target": "ES2015",
    "allowSyntheticDefaultImports": true,
    "lib": [
      "ESNext",
      "DOM"
    ],
    "baseUrl": ".",
    "outDir": "./build/",
    "typeRoots": [
      "./node_modules/@types/",
      "./src/types"
    ],
    "types": [],
  }
}